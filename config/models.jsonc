{
  // 统一维护所有可用模型；标准 JSON 也可以，另外支持 // 与 /* */ 注释。
  //
  // 说明：
  // 1. 每个模型都可以独立配置自己的 reasoning / thinking。
  // 2. `enabled` 用来控制该模型是否启用思考能力。
  // 3. OpenAI 支持：`enabled`、`effort`、`effort_options`、`summary`
  // 4. Google 支持：`enabled`、`include_thoughts`、`level`、`level_options`
  // 5. Claude 模型不需要 reasoning/thinking 配置（由模型自行决定）。
  // 6. 兼容旧写法：把 `reasoning` / `thinking` 直接写成 false 或 null，依然表示关闭。
  "openai": {
    "models": [
      {
        "name": "gpt-5.4",
        "label": "GPT-5.4（增强版）",
        "reasoning": {
          "enabled": true,
          "effort": "medium",
          "effort_options": ["minimal", "low", "medium", "high", "xhigh"],
          "summary": "concise"
        }
      },
      {
        "name": "gpt-5.5",
        "label": "GPT-5.5（旗舰版）",
        "reasoning": {
          "enabled": true,
          "effort": "high",
          "effort_options": ["minimal", "low", "medium", "high", "xhigh"],
          "summary": "auto"
        }
      }
    ]
  },
  "google": {
    "models": []
  },
  "claude": {
    // Claude 4.6 generation 起模型 ID 采用无日期后缀格式（pinned snapshot）。
    // thinking 字段控制 Adaptive Thinking：
    //   - enabled: 是否启用思考
    //   - effort: 思考强度（low / medium / high；Opus 4.7 还支持 xhigh / max）
    //   - include_thoughts: 是否返回思考摘要（对应 Anthropic 的 display 字段）
    "models": [
      {
        "name": "claude-opus-4-7",
        "label": "Claude Opus 4.7（旗舰，最强推理与代码）",
        "thinking": {
          "enabled": true,
          "include_thoughts": true,
          "effort": "high",
          "effort_options": ["low", "medium", "high", "xhigh", "max"]
        }
      },
      {
        "name": "claude-opus-4-6",
        "label": "Claude Opus 4.6（旗舰，深度思考）",
        "thinking": {
          "enabled": true,
          "include_thoughts": true,
          "effort": "high",
          "effort_options": ["low", "medium", "high", "max"]
        }
      },
      {
        "name": "claude-sonnet-4-6",
        "label": "Claude Sonnet 4.6（速度与智能平衡）",
        "thinking": {
          "enabled": true,
          "include_thoughts": true,
          "effort": "medium",
          "effort_options": ["low", "medium", "high", "max"]
        }
      }
    ]
  }
}